# =============================================================================
# KontrakAman AI — Backend Environment Variables
# Salin file ini ke .env dan isi nilainya. JANGAN commit .env ke git.
# =============================================================================

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/kontrakaman"

# --- JWT ---
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-min-64-karakter"
JWT_REFRESH_SECRET="ganti-dengan-secret-refresh-acak-min-64-karakter"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/v1/auth/google/callback"

# --- Mayar Payment Gateway ---
MAYAR_API_KEY="your-mayar-api-key"
MAYAR_WEBHOOK_SECRET="your-mayar-webhook-secret"
MAYAR_PRODUCT_ID_PRO_MONTHLY="mayar-product-id-pro-bulanan"
MAYAR_PRODUCT_ID_PRO_YEARLY="mayar-product-id-pro-tahunan"
MAYAR_PRODUCT_ID_BUSINESS_MONTHLY="mayar-product-id-bisnis-bulanan"
MAYAR_PRODUCT_ID_BUSINESS_YEARLY="mayar-product-id-bisnis-tahunan"

# --- Object Storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ---
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_REGION="ap-southeast-1"
STORAGE_BUCKET="kontrakaman-documents"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_CDN_URL="https://cdn.kontrakaman.id"

# --- Email (SMTP) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@kontrakaman.id"
SMTP_PASS="your-smtp-password"
EMAIL_FROM_NAME="KontrakAman AI"
EMAIL_FROM_ADDRESS="no-reply@kontrakaman.id"

# --- Backend AI (internal service) ---
BACKEND_AI_URL="http://localhost:3001"
BACKEND_AI_API_KEY="internal-service-api-key"

# --- Kuota Tier Gratis (default, dapat di-override via SystemConfig di DB) ---
FREE_TIER_AUDIT_QUOTA="5"
FREE_TIER_NEGOTIATION_QUOTA="3"

# --- Retensi Dokumen ---
# Jumlah hari dokumen disimpan sebelum dihapus otomatis (default 90 hari)
DOCUMENT_RETENTION_DAYS="90"

# --- Batas Upload ---
MAX_FILE_SIZE_BYTES="10485760"

# --- Aplikasi ---
# Backend berjalan di 4000 agar tidak bentrok dengan Next.js dev (3000)
NODE_ENV="development"
PORT="4000"
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
